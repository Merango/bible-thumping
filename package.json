{
  "name": "multi-agent-chat-platform",
  "version": "0.1.0",
  "description": "Multi-Agent Chat Platform with Comprehensive Testing",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "generate-coverage": "node scripts/generate-coverage-report.js",
    "lint": "eslint . --ext .ts",
    "prepare-coverage": "mkdir -p coverage && npm run test && npm run generate-coverage"
  },
  "dependencies": {
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.44.0",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageReporters": ["json", "lcov", "text", "clover"],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}