{
    "testEnvironment": "node",
    "coverageThreshold": {
        "global": {
            "branches": 80,
            "functions": 80,
            "lines": 80,
            "statements": 80
        }
    },
    "testMatch": [
        "**/tests/**/*.test.[jt]s?(x)",
        "**/tests/**/*.spec.[jt]s?(x)"
    ],
    "setupFiles": [
        "<rootDir>/tests/setup.js"
    ],
    "reporters": [
        "default",
        "jest-junit"
    ],
    "collectCoverageFrom": [
        "src/**/*.{js,jsx,ts,tsx}",
        "!**/node_modules/**",
        "!**/vendor/**"
    ]
}